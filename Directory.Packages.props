<Project>

	<!--
		Central Package Management (CPM): every NuGet package version used in this repository is declared here, once.
		Projects reference packages without a version: <PackageReference Include="Dapper" />.
		To upgrade a package, change its version here only. See Specs/central-package-management/ for the rules.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Microsoft.Extensions / ASP.NET Core / EF Core (keep on the same 11.0.x servicing release) -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
		<PackageVersion Include="System.Runtime.Caching" Version="11.0.0" />
	</ItemGroup>

	<!-- Third-party libraries -->
	<ItemGroup>
		<PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
		<PackageVersion Include="Dapper" Version="2.1.89" />
		<PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0-preview-04" />
		<PackageVersion Include="EFCore.BulkExtensions.SqlServer" Version="10.0.1" />
		<PackageVersion Include="EPPlus" Version="8.7.2" />
		<PackageVersion Include="EPPlus.DataExtractor" Version="2.2.0" />
		<PackageVersion Include="Experimental.System.Messaging" Version="1.2.0" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<PackageVersion Include="Polly" Version="8.9.1" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
	</ItemGroup>

	<!--
		Security pins: none at the moment. Bat 10.0.14 removed the pins on Microsoft.OpenApi, System.Security.Cryptography.Xml
		and System.Security.Cryptography.Pkcs: the upgraded parent packages already bring patched versions.
		If NU1903 reports a vulnerable transitive package again, pin it here (and add a <PackageReference> with a comment
		in the project that pulls it in), then remove the pin when the parent package catches up.
	-->

	<!-- Bat.Test (published test-helper library) -->
	<ItemGroup>
		<PackageVersion Include="AutoBogus" Version="2.13.1" />
		<PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
		<PackageVersion Include="MockQueryable.EntityFrameworkCore" Version="11.0.0" />
		<PackageVersion Include="MockQueryable.Moq" Version="11.0.0" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
	</ItemGroup>

	<!-- Test tooling (tests/, never shipped) -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>

</Project>
