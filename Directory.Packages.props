<Project>

	<!--
		Central Package Management (CPM): every NuGet package version used in this repository is declared here, once.
		Projects reference packages without a version: <PackageReference Include="Dapper" />.
		To upgrade a package, change its version here only. See Specs/central-package-management/ for the rules.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Microsoft.Extensions / ASP.NET Core / EF Core (keep on the same 10.0.x servicing release) -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageVersion Include="System.Runtime.Caching" Version="10.0.12" />
	</ItemGroup>

	<!-- Third-party libraries -->
	<ItemGroup>
		<PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
		<PackageVersion Include="Dapper" Version="2.1.89" />
		<PackageVersion Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0-preview-04" />
		<PackageVersion Include="EFCore.BulkExtensions.SqlServer" Version="10.0.1" />
		<PackageVersion Include="EPPlus" Version="8.7.1" />
		<PackageVersion Include="EPPlus.DataExtractor" Version="2.2.0" />
		<PackageVersion Include="Experimental.System.Messaging" Version="1.2.0" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageVersion Include="Polly" Version="8.8.0" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
	</ItemGroup>

	<!--
		Security pins: these packages are not used directly; they are referenced explicitly only to lift a vulnerable
		transitive version (NU1903). Re-check them whenever the parent package is upgraded.
	-->
	<ItemGroup>
		<!-- Pulled in by Swashbuckle.AspNetCore (Bat.AspNetCore). -->
		<PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
		<!-- Pulled in by EPPlus (Bat.Tools). -->
		<PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
	</ItemGroup>

	<!-- Bat.Test (published test-helper library) -->
	<ItemGroup>
		<PackageVersion Include="AutoBogus" Version="2.13.1" />
		<PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
		<PackageVersion Include="MockQueryable.EntityFrameworkCore" Version="10.0.12" />
		<PackageVersion Include="MockQueryable.Moq" Version="10.0.12" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
	</ItemGroup>

	<!-- Test tooling (tests/, never shipped) -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
	</ItemGroup>

</Project>
