<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Version>10.0.1</Version>
	  <Authors>Mehran Norouzi</Authors>
	  <Company>Mehran Norouzi</Company>
    <PackageIcon>Bat.png</PackageIcon>
    <RepositoryUrl>https://github.com/mehrannoruzi/Bat</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.5.4" />
    <PackageReference Include="EPPlus.DataExtractor" Version="2.2.0" />
    <!-- Pinned: the version pulled in by EPPlus has known high-severity vulnerabilities (NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bat.Core\Bat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
