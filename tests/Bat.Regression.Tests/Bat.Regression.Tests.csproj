<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Regression tests for the Bat packages. Run: dotnet test tests/Bat.Regression.Tests
    Sdk.Web is used only so the HTTP tests can host a tiny local server (no external network needed).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AspNetCore\Bat.Http\Bat.Http.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore\Bat.AspNetCore\Bat.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Cache\Bat.Cache\Bat.Cache.csproj" />
    <ProjectReference Include="..\..\src\Cache\Bat.Cache.Redis\Bat.Cache.Redis.csproj" />
    <ProjectReference Include="..\..\src\DataAccess\Bat.Dapper\Bat.Dapper.csproj" />
    <ProjectReference Include="..\..\src\DataAccess\Bat.EntityFrameworkCore.Tools\Bat.EntityFrameworkCore.Tools.csproj" />
  </ItemGroup>
</Project>
