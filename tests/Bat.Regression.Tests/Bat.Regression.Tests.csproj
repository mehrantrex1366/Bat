<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Regression tests for the Bat packages. Run: dotnet test tests/Bat.Regression.Tests
    The ASP.NET Core shared framework is referenced so the HTTP and Swagger tests can host a tiny local server
    (no external network needed). Microsoft.NET.Sdk.Web is not used: on the .NET 11 SDK its static web assets
    pipeline fails on a test project ("scoped css bundles do not have matching endpoints").
    xUnit v3: test projects are executables (OutputType Exe).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AspNetCore\Bat.Http\Bat.Http.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore\Bat.AspNetCore\Bat.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore\Bat.Di\Bat.Di.csproj" />
    <ProjectReference Include="..\..\src\Cache\Bat.Cache\Bat.Cache.csproj" />
    <ProjectReference Include="..\..\src\Cache\Bat.Cache.Redis\Bat.Cache.Redis.csproj" />
    <ProjectReference Include="..\..\src\DataAccess\Bat.Dapper\Bat.Dapper.csproj" />
    <ProjectReference Include="..\..\src\DataAccess\Bat.EntityFrameworkCore.Tools\Bat.EntityFrameworkCore.Tools.csproj" />
  </ItemGroup>
</Project>
